# ── Binaries (optional if yt-dlp and ffmpeg are on PATH) ─────────────────────

# Full path to yt-dlp executable
# Windows: YTDLP_PATH=C:\tools\yt-dlp.exe
# macOS/Linux: YTDLP_PATH=/usr/local/bin/yt-dlp

# Path to ffmpeg binary OR its bin directory
# Windows: FFMPEG_PATH=C:\ffmpeg\bin
# macOS (Homebrew): FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ── Local agent (connect live Vercel site to your Windows PC) ─────────────────

# Comma-separated browser origins allowed to call your local API (CORS)
# Include your Vercel URL when running scripts/start-local-agent.ps1
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# Used by start-local-agent.ps1 if not passed on the command line
# VERCEL_SITE_URL=https://your-app.vercel.app

# Ports the live site tries when auto-connecting on the same PC (optional)
# NEXT_PUBLIC_LOCAL_AGENT_PORTS=3000,3847


# Temp folder for completed downloads (auto-deleted after JOB_TTL_MS)
# DOWNLOAD_DIR=./downloads

# How long jobs and files are kept, in milliseconds (default: 1 hour)
# JOB_TTL_MS=3600000

# Max idle time during ffmpeg merge before the job is killed and retried (default: 10 min)
# PROCESSING_TIMEOUT_MS=600000
