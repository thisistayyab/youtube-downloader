# Copy to .env.local for local development. On Render, set any overrides in
# the dashboard (or render.yaml) instead — see README.md.

# ── Binaries ─────────────────────────────────────────────────────────────────
# The app resolves tools in this order: env var → ./bin (created by
# `npm run setup:binaries`) → system PATH (Render provides ffmpeg on PATH).

# Full path to the yt-dlp executable (skip if ./bin or PATH already works)
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Path to the ffmpeg binary OR its bin directory (skip if ffmpeg is on PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg

# ── YouTube Authentication & Cookies (Bypasses "Sign in to confirm you're not a bot") ───
# Path to a Netscape format cookies.txt file (or place cookies.txt in the project root)
# COOKIES_PATH=./cookies.txt

# Or paste the entire Netscape cookies.txt content directly as an env var (ideal for Render Dashboard):
# YOUTUBE_COOKIES="# Netscape HTTP Cookie File\n..."

# Optional HTTP/HTTPS proxy to route yt-dlp traffic through
# YTDLP_PROXY=http://user:password@proxy-host:port

# ── Storage & lifecycle ──────────────────────────────────────────────────────
# Temp folder for in-flight downloads (ephemeral; files are deleted shortly
# after they are streamed to the user's device)
# DOWNLOAD_DIR=./downloads

# Safety TTL for jobs/dirs that are never delivered to a device (default: 1 hour)
# JOB_TTL_MS=3600000

# Retry window after a file reached the user's device (default: 5 minutes)
# DELIVERED_JOB_TTL_MS=300000

# Max idle time during an ffmpeg merge before the job is killed and retried
# (default: 10 minutes)
# PROCESSING_TIMEOUT_MS=600000

# ── Limits (single-instance, in-memory) ──────────────────────────────────────
# Parallel yt-dlp/ffmpeg jobs (default: 3)
# MAX_CONCURRENT_JOBS=3

# Requests per minute per IP for metadata + download endpoints
# RATE_LIMIT_INFO_PER_MIN=30
# RATE_LIMIT_DOWNLOAD_PER_MIN=10
