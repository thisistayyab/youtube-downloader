# Path to yt-dlp binary (defaults to yt-dlp.exe on Windows, yt-dlp elsewhere)
# YTDLP_PATH=C:\tools\yt-dlp.exe

# Path to ffmpeg folder (bin) or ffmpeg.exe — used by Next.js, not Windows PATH
# FFMPEG_PATH=C:\ffmpeg-8.1.1-essentials_build\ffmpeg-8.1.1-essentials_build\bin

# Where finished downloads are stored temporarily (auto-deleted after TTL)
# DOWNLOAD_DIR=./downloads

# How long jobs/files are kept in milliseconds (default: 1 hour)
# JOB_TTL_MS=3600000
