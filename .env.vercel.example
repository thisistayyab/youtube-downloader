# Vercel environment variables
# Copy these into: Vercel Dashboard → Project → Settings → Environment Variables
# Apply to: Production, Preview, and Development

# Ports the live site probes when auto-connecting to a local agent on the same PC
NEXT_PUBLIC_LOCAL_AGENT_PORTS=3000

# ── Set on your Windows PC (.env.local), NOT on Vercel ───────────────────────
# After your first deploy, use your real Vercel URL:

# VERCEL_SITE_URL=https://youtube-downloader.vercel.app
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://youtube-downloader.vercel.app

# Vercel sets these automatically — do not add manually:
# VERCEL=1
# VERCEL_URL
# VERCEL_ENV
